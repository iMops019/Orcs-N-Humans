# Local Claude Code settings (machine-specific, not shared)
.claude/settings.local.json

# OS clutter
Thumbs.db
desktop.ini
.DS_Store

# ImGui auto-generated window layout state (DarkXEngine/tools/GameEditor,
# built as part of this repo via the submodule) - runtime artifact, not
# project content.
imgui.ini

# Player save data - not project content. Resolved next to the
# executable via engine::save::resolveSaveFilePath(), never at repo root,
# but ignored here too in case a build config ever lands one here.
/save.json
